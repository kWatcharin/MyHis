# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env ไม่ขึ้น git)
# รายละเอียดแต่ละค่าอ้างอิง docs/infrastructure.md และ docs/auth-design.md

# --- Database ---
DATABASE_URL=postgres://my_his:changeme@db:5432/my_his
POSTGRES_USER=my_his
POSTGRES_PASSWORD=changeme
POSTGRES_DB=my_his

# --- Server ---
BIND_ADDR=0.0.0.0:8080
# ระดับ log ของ backend (docs/infrastructure.md ข้อ 7) — ไม่ตั้ง = info; ตั้งทับได้ เช่น warn หรือ my_his_backend=debug
# ไม่ใส่ไว้ใน .env ก็ได้ แต่ถ้าตั้งเป็น error บรรทัดเตือน (Turnstile test key, IP ชนเพดาน login) จะไม่โผล่
RUST_LOG=info

# --- Session (docs/auth-design.md ข้อ 7) ---
SESSION_IDLE_TTL_HOURS=8
SESSION_ABSOLUTE_TTL_DAYS=30

# --- ผู้ใช้ admin คนแรก (docs/auth-design.md ข้อ 13) ---
# สร้างอัตโนมัติตอนเริ่มระบบถ้ายังไม่มีผู้ใช้เลย ห้าม hard-code ในโค้ด/migration
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=changeme-on-first-login

# --- เข้ารหัสข้อมูลผู้ป่วย (backend/src/crypto.rs) ---
# hex 64 ตัวอักษร (32 byte) 2 ค่าที่ต้องต่างกัน สร้างด้วย: openssl rand -hex 32
# ห้ามเปลี่ยน/ทำหายหลังมีข้อมูลจริงแล้ว — ข้อมูลที่เข้ารหัสไว้จะอ่านไม่ได้ตลอดกาล ต้องสำรองแยกจาก DB
DATA_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
BLIND_INDEX_KEY=generate-another-with-openssl-rand-hex-32

# --- Cloudflare Turnstile หน้า login (docs/auth-design.md ข้อ 9.1) ---
# ตั้งครบทั้งคู่ = เปิด, เว้นว่างทั้งคู่ = ปิด, ตั้งตัวเดียว = backend ไม่ยอมเริ่ม
# dev บน localhost ใช้ test key ของ Cloudflare ด้านล่าง (ผ่านทุกครั้ง ไม่ได้ป้องกันจริง) — key จริงสร้างใน Cloudflare dashboard
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# ไม่บังคับ: โดเมนที่ widget ต้องอยู่ (ตั้งเมื่อใช้ key จริง)
TURNSTILE_HOSTNAME=

# --- หน้า SQL /data/script (docs/infrastructure.md หัวข้อหน้า SQL) ---
# รหัสของ role ฐานข้อมูลอ่านอย่างเดียว my_his_sql_reader (backend สร้าง/อัปเดต role เองตอนเริ่ม) ยาว ≥ 16 ตัว
# สร้างด้วย: openssl rand -hex 24 — เว้นว่าง = ปิดหน้า SQL
SQL_CONSOLE_DB_PASSWORD=

# --- Caddy ---
DOMAIN=example.com
