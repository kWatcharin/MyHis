# เสิร์ฟ static build ของ SPA — try_files fallback ไป index.html เสมอถ้า path ที่ขอไม่ใช่ไฟล์
# จริง (เช่น /login, /dashboard) เพราะ react-router จัดการ routing เองฝั่ง client ทั้งหมด
#
# /api/* reverse proxy ไปที่ container backend ตรง ๆ ผ่าน network ภายในของ Compose (DNS ชื่อ
# service "backend") — ทำให้เบราว์เซอร์เห็นแค่ origin เดียว (localhost:3000) ไม่ต้องตั้ง CORS
# ฝั่ง backend เลย ต้องอยู่ "ก่อน" try_files ไม่งั้น /api/* จะโดน fallback ไป index.html แทน
#
# ฟังที่ :8080 (ไม่ใช่ 80) เพราะ container รันด้วย user ธรรมดา (nobody ดู Dockerfile) ที่ bind พอร์ตต่ำกว่า 1024 ไม่ได้
{
	# ไม่ใช้ admin API ของ Caddy (config คงที่จากไฟล์นี้) — ไม่เปิดพอร์ต 2019 ใน container
	admin off

	servers {
		# ขีดจำกัดระดับการเชื่อมต่อ ชุดเดียวกับ Caddy หน้าบ้าน (ops/Caddyfile) ยกเว้น idle ที่ยาวกว่า keep-alive ของฝั่งหน้าบ้าน
		# (2 นาที) เพื่อไม่ให้ชั้นนี้ปิด connection ที่ชั้นหน้ากำลังจะนำกลับมาใช้
		timeouts {
			read_header 10s
			read_body 30s
			write 30s
			idle 5m
		}
		max_header_size 16KB
	}
}

:8080 {
	# security header ทุก response (docs/infrastructure.md) — HSTS ยังไม่ใส่จนกว่าจะมี HTTPS จริง (Caddy หน้าบ้าน)
	# CSP: script ได้เฉพาะไฟล์ของเว็บเอง (theme-init.js แยกจาก index.html แล้ว), style ต้อง 'unsafe-inline' เพราะ React
	# ใช้ inline style (พื้นหลังหน้า login ฯลฯ) และ chart ของ shadcn, blob: สำหรับไฟล์ Excel ที่สร้างในเบราว์เซอร์
	# challenges.cloudflare.com = Cloudflare Turnstile หน้า login (script + iframe ตามเอกสาร CSP ของ Turnstile)
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	handle /api/* {
		# response ของ API มีข้อมูลคนไข้ — ห้ามเบราว์เซอร์/ตัวกลาง cache
		header Cache-Control "no-store"

		# มาจาก Caddy หน้าบ้าน (ops/Caddyfile): X-Real-IP = IP ผู้ใช้จริงที่ชั้นนั้นตัดสินแล้ว ({client_ip}: CF-Connecting-IP เมื่อมาทาง
		# Cloudflare ไม่งั้นคือ IP ของ TCP peer; ทับค่าที่ผู้ใช้ส่งมาเองแล้ว) ตั้งเป็น
		# X-Forwarded-For ตัวเดียวให้ backend (ประวัติการเข้าออกใช้ค่าขวาสุด — auth/handlers.rs client_ip) ไม่งั้น Caddy ชั้นนี้
		# จะเขียน XFF เป็น IP ของ Caddy หน้าบ้านซึ่งเป็นค่าเดียวกันทุกคน; พอร์ตนี้ไม่ publish ออกนอก network ภายใน
		# (ถ้าเข้าตรงโดยไม่ผ่านหน้าบ้าน เช่นตอน dev ไม่มี X-Real-IP ก็ใช้พฤติกรรมปริยายของ Caddy)
		#
		# max_conns_per_host 64 ต่อ reverse_proxy (2 ตัว รวม 128) = conn_guard::MAX_CONNECTIONS ของ backend ต้องแก้คู่กัน — ครบแล้ว
		# Caddy รอคิวคำขอเอง แทนที่จะไปค้างใน backlog ของ kernel ฝั่ง backend (docs/memory-optimization.md ข้อ 4.3)
		@via_front header X-Real-IP *
		reverse_proxy @via_front backend:8080 {
			header_up X-Forwarded-For {http.request.header.X-Real-IP}
			transport http {
				max_conns_per_host 64
			}
		}
		reverse_proxy backend:8080 {
			transport http {
				max_conns_per_host 64
			}
		}
	}

	handle {
		root * /usr/share/caddy
		encode gzip
		try_files {path} /index.html
		file_server
	}
}
