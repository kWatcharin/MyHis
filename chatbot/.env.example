# สำหรับรัน chatbot บนเครื่อง dev นอก Docker (uv run python scripts/dev.py) — คัดลอกเป็น chatbot/.env (git-ignore)
# ใน container ค่ามาจาก `environment:` ของ service chatbot ใน docker-compose.yml (ค่าจาก .env ที่ราก) ไม่ได้อ่านไฟล์นี้
# ห้ามคัดลอก key เข้ารหัสข้อมูลผู้ป่วยหรือ DATABASE_URL ของ backend มาไว้ที่นี่

# critical | error | warning | info | debug
CHATBOT_LOG_LEVEL=info
# จำนวน worker ของ gunicorn (1–8) — dev server (uvicorn --reload) ไม่ใช้ค่านี้
CHATBOT_WORKERS=2
# เพดานเวลาของการเรียก HTTP ขาออก (วินาที)
CHATBOT_HTTP_TIMEOUT_SECONDS=30
# เว้นว่าง = ไม่เปิด connection pool (ยังไม่ต่อ DB — ดู chatbot/README.md งานถัดไป)
# ตัวอย่างตอน dev: postgres://<role ของ chatbot>:<รหัส>@127.0.0.1:55432/my_his
CHATBOT_DATABASE_URL=
